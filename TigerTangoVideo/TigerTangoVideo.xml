<skin name="TigerTangoVideo" version="8" width="1920" height="1080" breaklineV="1" breaklineV2="1920"
			comment="Song details at top; global event name and date at bottom" author="Sean Ericson" image="Logo.png" preview="preview.png">
  <copyright>Free for all to use</copyright>
  <font name="Helvetica"/>
<!--breaklineV="960"  -->
	<group name="class_defines">
		<define color="background" value="#000000"/>
		<define color="darktext" value="#d6d6d6"/>
		<define color="orangetext" value="#F5A524"/>
		<define color="darkerorange" value="#B64A12"/>
		<define color="darkertext" value="#a0a0a0"/>
		<define color="brighttext" value="white"/>
	</group>

<!-- Branding and the optional event logo stay at the bottom right. -->
	<logo visibility="not has_logo 'videoskin'">
		<pos x="1720" y="+1000"/>
		<size width="172" height="43" />
	</logo>

	<visual>
		<pos x="1920-350" y="+660"/>
		<size width="280" height="140" />
		<off x="" y=""/>
	</visual>
<!-- Optional Custom Logo -->
	<visual>
		<pos x="1920-350" y="+820"/>
		<size width="280" height="140" />
		<off x="325" y="0"/>
	</visual>



<!-- Panel to show the artist, title, and album art of next track -->
	<group name="nexttrack" x="+1920-350" y="+30"
			visibility="automix ? (var_equal '@$hideNextTrack' 0)">
			<cover source="automix 1" visibility="var_equal '@$albumArtSize' 2 ? false : true">
				<pos x="+0" y="+0"/>
				<size width="200" height="200"/>
			</cover>
			<textzone>
				<pos x="+0" y="+220"/>
				<size width="320" height="40"/>
				<text fontsize="28" align="left" color="darkertext" text="Next Song:"/>
			</textzone>
			<textzone group="horizontal" scroll="yes" align="left">
				<pos x="+0" y="+260"/>
				<size width="320" height="60"/>
				<text fontsize="28" color="darktext" action="get_automix_song 'artist' 1  & param_uppercase"/>
			</textzone>
			<textzone group="horizontal" scroll="yes" align="left" >
				<pos x="+0" y="+310"/>
				<size width="320" height="60"/>
				<text fontsize="28" color="orangetext" weight="bold" action="get_automix_song 'title' 1 & param_uppercase"/>
			</textzone>
	</group>

	<group name="masterdeck" x="+150" y="+40">
		<deck deck="master">
			<!-- Album art display. albumArtSize: 0 = large, 1 = small, 2 = none.
			 	 If lyrics are active and there are lyrics (comments not blank)
				 Then show for 10 seconds and then hide) -->
			<!-- Keep artwork below the song header, including large-title mode. -->
			<cover x="+710-400" y="+440" width="700" height="560"
				visibility="var_equal '@$ttShowEvent' 1 ? false :
							var_equal '@$albumArtSize' 1 ? false :
							var_equal '@$albumArtSize' 2 ? false :
								(var_equal '@$showLyrics' 0 ? true :
									get_comment & param_equal '' ? true :
									load_pulse_active 10000ms)"/>
				<!-- Small cover -->
				<cover x="+710-200" y="+700" width="300" height="300"
					visibility="var_equal '@$ttShowEvent' 1 ? false :
					var_equal '@$albumArtSize' 0 ? false :
					var_equal '@$albumArtSize' 2 ? false :
					(var_equal '@$showLyrics' 0 ? true :
					get_comment & param_equal '' ? true :
					load_pulse_active 10000ms)"/>

			<!-- Reserve screen y=810..1050 for the global event when enabled. -->
			<cover x="+710-400" y="+440" width="700" height="320"
				visibility="var_equal '@$ttShowEvent' 1 ?
					(var_equal '@$albumArtSize' 0 ?
						(var_equal '@$showLyrics' 0 ? true :
							get_comment & param_equal '' ? true : load_pulse_active 10000ms) : false) : false"/>
			<cover x="+710-200" y="+460" width="300" height="300"
				visibility="var_equal '@$ttShowEvent' 1 ?
					(var_equal '@$albumArtSize' 1 ?
						(var_equal '@$showLyrics' 0 ? true :
							get_comment & param_equal '' ? true : load_pulse_active 10000ms) : false) : false"/>

			<!-- Comments share the song header's left margin at x=75.
			     They end at y=1040 without the event, or y=800 with it. -->
			<!-- Display Lyrics Only show if showLyrics is set to 1 and comments are not empty-->

			<!-- Full-height Comments when the global event is hidden. -->
			<group name="lyrics_panel" x="-75" y="+440"
					visibility="var_equal '@$showLyrics' 0 ? false :
								var_equal '@$ttShowEvent' 1 ? false :
							get_comment & param_equal '' ? false :
							not load_pulse_active 10000ms">
			<!-- Small text -->
			<text x="+0" y="+0" width="1200" height="560" fontsize="48" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 3 ? true : false"/>

			<!-- Medium text -->
			<text x="+0" y="+0" width="1200" height="560" fontsize="64" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 0 ? true : false"
			/>
			<!-- Large Text -->
			<text x="+0" y="+0" width="1200" height="560" fontsize="80" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 1 ? true : false"/>
			<!-- Larger Text -->
			<text x="+0" y="+0" width="1200" height="560" fontsize="96" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 2 ? true : false"
			/>
		</group>
		<!-- Shorter Comments area leaves room for the global event. -->
			<group name="lyrics_panel" x="-75" y="+440"
					visibility="var_equal '@$showLyrics' 0 ? false :
								var_equal '@$ttShowEvent' 1 ?
									(get_comment & param_equal '' ? false : not load_pulse_active 10000ms) : false">
			<!-- Small text -->
			<text x="+0" y="+0" width="1200" height="320" fontsize="48" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 3 ? true : false"
			/>
			<!-- Mid text -->
			<text x="+0" y="+0" width="1200" height="320" fontsize="64" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 0 ? true : false"
			/>
			<!-- Large Text -->
			<text x="+0" y="+0" width="1200" height="320" fontsize="80" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 1 ? true : false"/>
			<!-- Larger Text -->
			<text x="+0" y="+0" width="1200" height="320" fontsize="96" color="#EDEFF2"
			action="get_comment" align="left" valign="bottom" multiline="yes" font="Helvetica" weight="bold"
			visibility="var_equal '@$lyricsFont' 2 ? true : false"
			/>
		</group>

			<!-- Song details share the event text's left margin in both sizes. -->
			<group name="Normal Text Size" visibility="var_equal '@$largeTitleText' 0">
				<blockwave deck="master" blocksize="3" zoom="2" color="#B64A12" center="center"
							visibility="var_equal '@$hideWaveForm' 0">
					<pos x="+0" y="-26" width="1920-500" height="300"/>
				</blockwave>
			<!-- Genre and tanda counter -->
				<group name="track_text" x="-75" y="+0">
				<textzone group="horizontal" align="left">
					<pos x="+0" y="+0"/>
					<size width="1920-500" height="60"/>
					<text fontsize="56" color="orangetext" weight="bold"
							action="var_equal '$songCounterRunning' 0 ?
									var_equal '@$hideGenre' 1 ? '' : (get_genre & param_uppercase) : (
										var_equal '$tandaLength' 1 ? get_text 'CORTINA' :
									(
									var_equal '@$hideGenre' 1 ? (get_text '`get_var $tandaCounter`/`get_var $tandaLength`') :
									get_text '`get_genre & param_uppercase` – `get_var $tandaCounter`/`get_var $tandaLength`')
									)"/>
					<!-- Recording year, appended to the genre line as " – YYYY".
						 Returns '' when showYear is off, the track has no year, or the
						 track is a cortina. The conditions live in the action rather
						 than a visibility attribute, which is ignored on a text
						 fragment inside a textzone.
						 The dash is dropped when the genre line itself is blank -->
					<text fontsize="56" color="orangetext" weight="bold"
							action="var_equal '@$showYear' 0 ? '' :
									get_year & param_equal '' ? '' :
									var_equal '$songCounterRunning' 0 ?
										(var_equal '@$hideGenre' 1 ? get_text '`get_year`' :
										 get_genre & param_equal '' ? get_text '`get_year`' :
										 get_text ' – `get_year`') :
									var_equal '$tandaLength' 1 ? '' :
									get_text ' – `get_year`'"/>
				</textzone>
				<!-- Track artist -->
				<textzone group="horizontal" align="left" attachX="both" scroll="yes">
					<pos x="+0" y="+75"/>
					<size width="1920-500" height="75"/>
					<text fontsize="56" color="darktext" weight="bold" action="get_artist_before_feat & param_uppercase"/>
					<text fontsize="56" color="darktext" weight="regular" action="get_featuring_after_artist & param_uppercase"/>
				</textzone>

				<!-- Track title -->
				<textzone group="horizontal" align="left" attachX="both" scroll="yes">
					<pos x="+0" y="+140"/>
					<size width="1920-500" height="100"/>
					<text fontsize="56" color="orangetext" weight="bold" action="get_title_before_remix 'clean' & param_uppercase"/>
				</textzone>
				</group>
			</group>
		<!-- LARGE TEXT -->
			<group name="Large Text Size" visibility="var_equal '@$largeTitleText' 1">

			<blockwave deck="master" blocksize="3" zoom="2" color="#B64A12" center="center" 
						visibility="var_equal '@$hideWaveForm' 0">
					<pos x="+0" y="+75" width="1920-500" height="300"/>
			</blockwave>
			<!-- Genre and tanda counter -->
				<group name="track_text" x="-75" y="+0">
				<textzone group="horizontal" align="left">
					<pos x="+0" y="+0"/>
					<size width="1920-500" height="160"/>
					<text fontsize="56+56+12" color="orangetext" weight="bold"
							action="var_equal '$songCounterRunning' 0 ?
									var_equal '@$hideGenre' 1 ? '' : (get_genre & param_uppercase) : (
										var_equal '$tandaLength' 1 ? get_text 'CORTINA' :
									(
									var_equal '@$hideGenre' 1 ? (get_text '`get_var $tandaCounter`/`get_var $tandaLength`') :
									get_text '`get_genre & param_uppercase` – `get_var $tandaCounter`/`get_var $tandaLength`')
									)"/>
					<!-- Recording year, appended to the genre line as " – YYYY".
						 Returns '' when showYear is off, the track has no year, or the
						 track is a cortina. The conditions live in the action rather
						 than a visibility attribute, which is ignored on a text
						 fragment inside a textzone.
						 The dash is dropped when the genre line itself is blank -->
					<text fontsize="56+56+12" color="orangetext" weight="bold"
							action="var_equal '@$showYear' 0 ? '' :
									get_year & param_equal '' ? '' :
									var_equal '$songCounterRunning' 0 ?
										(var_equal '@$hideGenre' 1 ? get_text '`get_year`' :
										 get_genre & param_equal '' ? get_text '`get_year`' :
										 get_text ' – `get_year`') :
									var_equal '$tandaLength' 1 ? '' :
									get_text ' – `get_year`'"/>
				</textzone>
				<!-- Track artist -->
				<textzone group="horizontal" align="left" attachX="both" scroll="yes">
					<pos x="+0" y="+125"/>
					<size width="1920-500" height="160"/>
					<text fontsize="56+56+12" color="darktext" weight="bold" action="get_artist_before_feat & param_uppercase"/>
					<text fontsize="56+56+12" color="darktext" weight="regular" action="get_featuring_after_artist & param_uppercase"/>
				</textzone>

				<!-- Track title -->
				<textzone group="horizontal" align="left" attachX="both" scroll="yes">
					<pos x="+0" y="+250"/>
					<size width="1920-500" height="160"/>
					<text fontsize="56+56+12" color="orangetext" weight="bold" action="get_title_before_remix 'clean' & param_uppercase"/>
				</textzone>
				</group>
			</group>
		</deck>

	</group>

	<!-- Global fields are independent of the loaded track and artwork timer.
	     Fixed-font, wrapping text avoids the native Text effect's auto-fit box. -->
	<group name="event_footer" x="75" y="810" visibility="var_equal '@$ttShowEvent' 1">
		<group name="event_medium" visibility="var_equal '@$ttEventSize' 0">
			<text x="+0" y="+0" width="1420" height="120" fontsize="64" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventName'"/>
			<text x="+0" y="+120" width="1420" height="120" fontsize="64" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventDate'"/>
		</group>
		<group name="event_large" visibility="var_equal '@$ttEventSize' 1">
			<text x="+0" y="+0" width="1420" height="120" fontsize="80" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventName'"/>
			<text x="+0" y="+120" width="1420" height="120" fontsize="80" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventDate'"/>
		</group>
		<group name="event_larger" visibility="var_equal '@$ttEventSize' 2">
			<text x="+0" y="+0" width="1420" height="120" fontsize="96" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventName'"/>
			<text x="+0" y="+120" width="1420" height="120" fontsize="96" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventDate'"/>
		</group>
		<group name="event_small" visibility="var_equal '@$ttEventSize' 3">
			<text x="+0" y="+0" width="1420" height="120" fontsize="48" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventName'"/>
			<text x="+0" y="+120" width="1420" height="120" fontsize="48" font="Helvetica" weight="bold" color="#EDEFF2" align="left" valign="top" multiline="yes" action="get_var '@$ttEventDate'"/>
		</group>
	</group>

</skin>
